# Optional. Without a key the diagnosis layer falls back to a deterministic
# narrator, so the demo still runs end to end -- it just writes less well.
ANTHROPIC_API_KEY=sk-ant-...
PAYOPS_MODEL=claude-sonnet-4-5
# Wall-clock seconds per simulated minute. 1.4 is a good pace to narrate over;
# drop to 0.6 to compress the whole incident arc into a few seconds.
PAYOPS_TICK_SECONDS=1.4
