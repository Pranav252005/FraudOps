# Sentinel — LLM configuration (OpenRouter).
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so never
# put a real key here.
#
# Sentinel runs fully without any of this. With no key set, narrative drafting
# uses the deterministic template path, which is the one that carries the
# citation-by-construction guarantee. The LLM path is optional by design.
#
#   cp .env.example .env
#   # then, in your shell:
#   set -a; . ./.env; set +a          # bash / zsh
#   Get-Content .env | ForEach-Object { if ($_ -match '^\s*([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim()) } }   # PowerShell
#
# Verify it works:  python scripts/check_llm.py

# --- Required for the LLM path ---------------------------------------------

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: endpoint -----------------------------------------------------

# Point at a proxy or any other OpenAI-compatible gateway. `/chat/completions`
# is appended to this.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: model --------------------------------------------------------

# An OpenRouter model slug (`vendor/model`). Check the exact current slug at
# https://openrouter.ai/models — slugs are versioned and they move.
SENTINEL_LLM_MODEL=anthropic/claude-sonnet-4.5

# 0 = deterministic. A filed narrative is an auditable artifact; two runs over
# the same case file should produce the same text. Raise only for a deliberate
# sampling experiment.
SENTINEL_LLM_TEMPERATURE=0

SENTINEL_LLM_MAX_TOKENS=1500

# --- Optional: failure behaviour --------------------------------------------

# Past this, the call is abandoned and the template path is used instead.
SENTINEL_LLM_TIMEOUT=30

# Transport faults only (timeout, 5xx, reset). A 4xx is a config error and is
# never retried.
SENTINEL_LLM_MAX_RETRIES=2

# --- Optional: attribution --------------------------------------------------

SENTINEL_APP_URL=https://github.com/Pranav252005/FraudOps
SENTINEL_APP_TITLE=Sentinel
